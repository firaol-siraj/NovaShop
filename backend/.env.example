# ==========================================
# NovaShop Backend Environment Configuration
# ==========================================

# Server
NODE_ENV=development
PORT=5000

# Database and Cache
MONGO_URL=mongodb://127.0.0.1:27017/novashop
REDIS_URL=redis://127.0.0.1:6379

# Frontend URLs
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Backend URLs
API_BASE_URL=http://localhost:5000/api/v1
BACKEND_URL=http://localhost:5000
BACKEND_PUBLIC_URL=http://localhost:5000/api/v1

# Chapa Callback
CHAPA_CALLBACK_URL=http://localhost:5000/api/v1/orders/webhook/chapa

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cookie Security (strict, lax, or none)
COOKIE_SAME_SITE=strict
# COOKIE_DOMAIN=.yourdomain.com

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=replace-with-your-email-app-password

FROM_NAME=NovaShop
FROM_EMAIL=your-email@gmail.com
EMAIL_FROM="NovaShop <your-email@gmail.com>"

# Optional Mailtrap Sandbox
# EMAIL_MODE=sandbox
# MAILTRAP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_PORT=2525
# MAILTRAP_USER=your-mailtrap-username
# MAILTRAP_PASS=your-mailtrap-password

# Chapa Payment Gateway
CHAPA_PUBLIC_KEY=your-chapa-public-key
CHAPA_SECRET_KEY=replace-with-your-chapa-secret
CHAPA_MODE=test
CHAPA_WEBHOOK_SECRET=replace-with-your-webhook-secret

# Currency
USD_TO_ETB_RATE=120

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-secret

# Store Configuration
STORE_TIMEZONE=Africa/Addis_Ababa
SUPPORT_EMAIL=support@example.com

# Local Upload Configuration
UPLOAD_DIR=uploads

# Customer Support / Inbound Email
INBOUND_EMAIL_WEBHOOK_SECRET=replace-with-your-inbound-webhook-secret

# IMAP Configuration
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-email@gmail.com
IMAP_PASS=replace-with-your-imap-password
IMAP_PASSWORD=replace-with-your-imap-password
